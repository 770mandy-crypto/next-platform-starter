# Stripe — get these from https://dashboard.stripe.com/apikeys
# Use the "Test mode" keys first (they start with sk_test_...).
# When the store is live and you're ready to charge real cards, swap in the
# live key (sk_live_...) in your Netlify environment variables.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe webhook signing secret (starts with whsec_...). Required for automatic
# order fulfillment. Create a webhook at https://dashboard.stripe.com/webhooks
# pointing to https://YOUR_SITE/api/webhook, subscribed to checkout.session.completed.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Order fulfillment — how paid orders get shipped. Leave unset for demo mode.
# Options: webhook | printful
FULFILLMENT_PROVIDER=

# For FULFILLMENT_PROVIDER=webhook: paid orders are POSTed here (your supplier,
# 3PL, or an automation like Zapier/Make/n8n). The optional secret is sent as
# the X-Fulfillment-Secret header so your endpoint can verify the request.
FULFILLMENT_WEBHOOK_URL=
FULFILLMENT_WEBHOOK_SECRET=

# For FULFILLMENT_PROVIDER=printful: your Printful API key. Each product in
# data/products.json also needs a printfulVariantId (the synced variant to ship).
PRINTFUL_API_KEY=
