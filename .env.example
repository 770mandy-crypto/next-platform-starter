# VALENTOS — Database Configuration (Required for production)
#
# Get these from Supabase:
#   1. Go to https://supabase.com
#   2. Create a new project
#   3. Copy these from Settings → API → Project URL and anon key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Configuration (Required for payments)
#
# Get these from https://stripe.com/docs/keys#api-keys
# Use test keys for development, production keys for live

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin Configuration

ADMIN_PASSWORD=admin123

# Shopify Storefront API (optional - legacy).
#
# Leave unset to use local catalog in data/products.js

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
