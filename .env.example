# Copy to .env.local for local development. All of these are optional — the app
# starts without any of them and reports what is missing.

# ---------------------------------------------------------------------------
# Prices
# ---------------------------------------------------------------------------
# Running locally you usually need NOTHING here: from a normal home or office
# connection Yahoo answers fine, and the app uses it automatically.
#
# On a cloud host it is the opposite. A shared datacenter IP gets 429 Too Many
# Requests from Yahoo, and Stooq answers with a JavaScript browser-verification
# page instead of data. A keyed provider is the only thing that works there.
#
# Free key (800 requests/day, 8/minute): https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# ---------------------------------------------------------------------------
# Fundamentals — P/E, growth, margins, debt
# ---------------------------------------------------------------------------
# Without this, reports are technical-only. Yahoo can supply fundamentals from a
# normal connection, but not from a cloud host.
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# The bot's spoken-language summary
# ---------------------------------------------------------------------------
# Without this a built-in rule-based Hebrew summary is used instead. Every
# number in the report is computed either way.
#
# This key is also what powers /upload — reading a stock screenshot needs vision,
# so that page is the one feature that does not work at all without it. Note that
# each upload is a paid vision call against your own key.
#
# It also switches /pilot (Maslul AI) from its built-in demo mode to Claude for
# planning, chat, research and writing.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Maslul accounts and storage
# ---------------------------------------------------------------------------
# On Netlify, accounts are stored in Netlify Blobs automatically. Locally,
# `npm run dev` stores them in .data/. To run a production build locally
# (`next start`) set MASLUL_STORE=file. Tests use MASLUL_STORE=memory.
# MASLUL_STORE=file
# AI actions (plan, chat, research, writing) allowed per user per day.
# MASLUL_AI_DAILY_LIMIT=150

# ---------------------------------------------------------------------------
# AI Studio (/studio) — video generation, dubbing, voice-over, music, editing
# ---------------------------------------------------------------------------
# The studio's chat runs on ANTHROPIC_API_KEY (above). Each key below connects
# one more service; the studio works with any subset and says what is missing.
# Every job is billed by that provider against your own account.
#
# Dubbing into other languages + voice-over: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=          # default narration voice (a premade voice otherwise)
# ELEVENLABS_TTS_MODEL=eleven_v3
#
# Video, image and music models (Veo, Kling, Hailuo, FLUX, MiniMax Music):
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Model slugs change as vendors ship new versions. Point a slot at another
# Replicate model ("owner/name") without touching code:
# STUDIO_MODEL_VEO=google/veo-3.1
# STUDIO_MODEL_KLING=kwaivgi/kling-v2.1-master
# STUDIO_MODEL_HAILUO=minimax/hailuo-02-fast
# STUDIO_MODEL_FLUX=black-forest-labs/flux-1.1-pro
# STUDIO_MODEL_MUSIC=minimax/music-1.5
#
# Cloud video editing (joining clips, music, narration, titles):
# https://dashboard.shotstack.io/ — the free "stage" key renders watermarked
# video; set SHOTSTACK_ENV=v1 with a production key for clean output.
SHOTSTACK_API_KEY=
# SHOTSTACK_ENV=stage
#
# Paid provider jobs allowed per user per day.
# STUDIO_DAILY_JOB_LIMIT=40

# ---------------------------------------------------------------------------
# Overrides — only needed for testing against fixture servers
# ---------------------------------------------------------------------------
# PRICE_PROVIDER=twelvedata      # pin one provider: twelvedata | yahoo | stooq
# FUNDAMENTALS_PROVIDER=finnhub  # pin one provider: finnhub | yahoo
# YAHOO_TIMEOUT_MS=3000          # how long Yahoo may take before falling through
# TWELVEDATA_HOST=
# FINNHUB_HOST=
# STOOQ_HOST=
# REPLICATE_HOST=
# ELEVENLABS_HOST=
# SHOTSTACK_HOST=
# YAHOO_CHART_HOST=
# YAHOO_QUOTE_HOST=
# YAHOO_COOKIE_HOST=
