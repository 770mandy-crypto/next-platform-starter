# Copy to .env for local development. The EXPO_PUBLIC_ values are embedded in
# the app (they are public by design — security comes from the database's
# row-level security, not from hiding these).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Build-time only (set as EAS environment variables for cloud builds).
APP_BUNDLE_ID=il.co.giveback.app
EAS_PROJECT_ID=
GOOGLE_MAPS_ANDROID_KEY=
